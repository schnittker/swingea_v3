; SwingGoldEA - E8 One Challenge (500k$, 1:30 Hebel), Stand 2026-08-20
; Basis: Pass 108 (500k/1:30-Test), 30,1% Profit, DD 12,29% Equity / 11,36% Balance
; InpMaxLotsPerTicket=20 ist PFLICHT fuer E8 (Broker-Ticket-Cap XAUUSD) - nicht auf 0 setzen
; InpUseNewsFilter=false ist in der Challenge-Phase korrekt (News-Trading dort unbeschraenkt,
;   nur die spaetere Performance-Phase verbietet Trades +-5 Min um High-Impact-News)
; ACHTUNG - noch offener Punkt: E8s echte "Dynamic Drawdown" rastet auf dem hoechsten
;   GESCHLOSSENEN Balance-Stand ein, nicht auf dem Equity-Peak wie CDrawdownGuard hier -
;   InpMaxDailyLossPct/InpMaxTotalDDPct sind interne Sicherheitsnetze, keine exakte
;   Nachbildung der E8-Regel. Lot-Cap-Retest (Pass 108 mit aktivem 20-Lot-Cap) war zuletzt
;   noch offen/lief beim Nutzer.
;
InpUseDipBuyModule=true
InpUseOverlapModule=true
InpUseAsiaModule=false
InpAsiaRequireRetest=true
InpAsiaBoxStartHour=0
InpAsiaBoxEndHour=8
InpAsiaRetestToleranceAtrMult=0.2
InpAsiaConfirmBars=8
InpAsiaAtrStopMult=1.5
InpUseSessionFilter=true
InpUseWeekdayFilter=false
InpOverlapStartGmtHour=12
InpOverlapEndGmtHour=16
InpMondayStartGmtHour=8
InpFridayStopGmtHour=18
InpGmtOffsetWinter=2
InpGmtOffsetSummer=3
InpUseSpreadFilter=false
InpMaxSpreadPoints=150
InpRiskPctDipBuy=0.5
InpRiskPctOverlap=5.0
InpRiskPctAsia=1.0
InpMaxClusterRiskPct=22.0
InpMetalCluster=XAUUSD,XAGUSD,AUDUSD
InpClusterCountForeign=true
InpClusterNoSLBlocks=true
InpMaxRiskPctPerTrade=20.0
InpMaxLotsPerTicket=20.0
InpFrictionSLMult=15.0
InpSlippageBufferPts=20.0
InpMaxDailyLossPct=3.0
InpMaxTotalDDPct=100.0
InpPartialPct=50.0
InpUseNewsFilter=false
InpNewsBlackoutMinBefore=5
InpNewsBlackoutMinAfter=5
InpNewsCsvPath=news_schedule.csv
InpMagicBase=770000
InpLogDecisions=true
InpEnableEmailNotify=false
