; SwingGoldEA - E8 Challenge (500k USD, 1:30), Stand 2026-09-09
; Neu-Optimierung mit London-Modul (vorheriges Preset hatte London nicht).
; Validierter Kandidat (Pass 395, Einzeltest 500k USD, 2020.01.01-2026.09.05):
;   DipBuy=9.0 / Overlap=2.0 / London=1.0 / AtrStopMult=1.25
;   Profit:        40.97% (0.512%/Mo) ueber 80 Monate
;   Balance-DD:    11.45%  (E8-Limit: 14%)
;   Max. Tages-DD: 4.64%   (E8-Limit: 9.2%) - kein Tag >= 9.2% in 1061 Handelstagen
;   PF:            1.157
;
; Vergleich altes Preset (kein London, DipBuy=0.5/Overlap=5.0):
;   Profit: 35.19% (0.440%/Mo), DD: 11.36% -> +16% Profit, niedrigere DD
;
; E8-Challenge-Regeln:
;   Profit-Ziel:        21% (= 605.000 USD) - kein Zeitlimit
;   Max. Tages-Verlust: 9.2% (Dynamic Drawdown)
;   Max. Gesamtverlust: 14% (Dynamic Drawdown vom Peak-Balance)
;   Hinweis: EA stoppt NICHT automatisch bei 21% - manuell deaktivieren!
;
; InpMaxDailyLossPct=9.0: knapp unter E8s 9.2%-Tageslimit.
;   Natuerliche Tages-DD max. 4.64% - Kill-Switch wird nie ausgeloest.
; InpMaxTotalDDPct=100 (deaktiviert): permanentes Veto wuerde Strategie
;   zerstoeren (s. ea.md / E8Challenge-Erfahrung).
; InpMaxLotsPerTicket=20: E8-Broker-Cap fuer XAUUSD.
; InpMaxRiskPctPerTrade=20: muss >= DipBuy (9.0) sein.
;
; ACHTUNG - vor Go-Live:
;   - GMT-Offset an E8-Broker-Server anpassen
;   - Symbol-Name pruefen (XAUUSD oder Variante)
;   - Demo-Forward-Test empfohlen (ea.md 8.5)
;   - Bei ~20% Profit: EA manuell stoppen um Ziel zu sichern!
;
InpUseDipBuyModule=true
InpUseOverlapModule=true
InpUseAsiaModule=false
InpAsiaRequireRetest=true
InpAsiaBoxStartHour=0
InpAsiaBoxEndHour=8
InpAsiaRetestToleranceAtrMult=0.2
InpAsiaConfirmBars=8
InpAsiaAtrStopMult=1.5
InpAsiaForceCloseGmtHour=-1
InpUseLondonModule=true
InpRiskPctLondonBreakout=1.0
InpLondonRangeStartGmtHour=8
InpLondonRangeEndGmtHour=13
InpLondonEntryStartGmtHour=13
InpLondonEntryEndGmtHour=14
InpLondonAtrStopMult=1.25
InpLondonRRMult=2.0
InpLondonMinBreakoutAtrMult=0.0
InpLondonDisableFriday=false
InpLondonForceCloseGmtHour=21
InpUseSessionFilter=true
InpUseWeekdayFilter=false
InpOverlapStartGmtHour=12
InpOverlapEndGmtHour=16
InpMondayStartGmtHour=8
InpFridayStopGmtHour=18
InpGmtOffsetWinter=2
InpGmtOffsetSummer=3
InpUseSpreadFilter=false
InpMaxSpreadPoints=150
InpRiskPctDipBuy=9.0
InpRiskPctOverlap=2.0
InpRiskPctAsia=1.0
InpMaxClusterRiskPct=22.0
InpMetalCluster=XAUUSD,XAGUSD,AUDUSD
InpClusterCountForeign=true
InpClusterNoSLBlocks=true
InpMaxRiskPctPerTrade=20.0
InpMaxLotsPerTicket=20.0
InpFrictionSLMult=15.0
InpSlippageBufferPts=20.0
InpMaxDailyLossPct=9.0
InpMaxTotalDDPct=100.0
InpPartialPct=50.0
InpUseNewsFilter=false
InpNewsBlackoutMinBefore=5
InpNewsBlackoutMinAfter=5
