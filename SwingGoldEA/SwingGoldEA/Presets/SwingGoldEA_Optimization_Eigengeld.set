; SwingGoldEA - OPTIMIERUNGS-Set fuer Eigengeld (Inputs-Tab -> Laden),
; NICHT fuer Live/Deployment gedacht.
; Fokus: InpLondonRRMult isoliert optimieren.
; Alle anderen Parameter fixiert auf validiertem Best-Kandidat:
;   DipBuy=23.0 / Overlap=1.5 / London=3.0
;
; Tester-Tab (manuell setzen):
;   Expert:      SwingGoldEA
;   Symbol:      XAUUSD
;   Period:      M15
;   Zeitraum:    2020.01.01 - aktuell
;   Modellierung: 1-Minuten-OHLC
;   Deposit:     10.000 EUR
;   Leverage:    1:30
;   Optimierung: Langsamer kompletter Algorithmus (11 Passes)
;   Kriterium:   Balance Max.
;
InpUseDipBuyModule=true
InpUseOverlapModule=true
InpUseAsiaModule=false
InpAsiaRequireRetest=true
InpAsiaBoxStartHour=0
InpAsiaBoxEndHour=8
InpAsiaRetestToleranceAtrMult=0.2
InpAsiaConfirmBars=8
InpAsiaAtrStopMult=1.5
InpAsiaForceCloseGmtHour=-1
InpUseLondonModule=true
InpRiskPctLondonBreakout=3.0
InpLondonRangeStartGmtHour=8
InpLondonRangeEndGmtHour=13
InpLondonEntryStartGmtHour=13
InpLondonEntryEndGmtHour=14
InpLondonAtrStopMult=1.0
InpLondonRRMult=2.00000000||1.50000000||0.25000000||4.00000000||1
InpLondonMinBreakoutAtrMult=0.0
InpLondonDisableFriday=false
InpLondonForceCloseGmtHour=21
InpUseSessionFilter=true
InpUseWeekdayFilter=false
InpOverlapStartGmtHour=12
InpOverlapEndGmtHour=16
InpMondayStartGmtHour=8
InpFridayStopGmtHour=18
InpGmtOffsetWinter=2
InpGmtOffsetSummer=3
InpUseSpreadFilter=false
InpMaxSpreadPoints=150
InpRiskPctDipBuy=23.0
InpRiskPctOverlap=1.5
InpRiskPctAsia=1.0
InpMaxClusterRiskPct=50.0
InpMetalCluster=XAUUSD,XAGUSD,AUDUSD
InpClusterCountForeign=true
InpClusterNoSLBlocks=true
InpMaxRiskPctPerTrade=25.0
InpMaxLotsPerTicket=20.0
InpFrictionSLMult=15.0
InpSlippageBufferPts=20.0
InpMaxDailyLossPct=100.0
InpMaxTotalDDPct=100.0
InpPartialPct=50.0
InpUseNewsFilter=false
InpNewsBlackoutMinBefore=5
InpNewsBlackoutMinAfter=5
InpNewsCsvPath=news_schedule.csv
InpMagicBase=770000
InpLogDecisions=true
InpEnableEmailNotify=false
